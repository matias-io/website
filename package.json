{
  "name": "my-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-assets.mjs",
    "prebuild": "npm run knowledge:build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "knowledge:build": "node scripts/knowledge-build.mjs",
    "knowledge:preview": "npm run knowledge:build && node scripts/knowledge-sync.mjs --dry-run",
    "knowledge:sync": "node scripts/knowledge-sync.mjs",
    "knowledge:prune": "node scripts/knowledge-sync.mjs --prune",
    "check": "npm run knowledge:build && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:worker && npm run test",
    "preview": "wrangler dev --port 3301",
    "deploy": "npm run build && npm run knowledge:sync && wrangler deploy && npm run knowledge:prune",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "i18next": "26.4.2",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260914.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
